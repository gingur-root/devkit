{
  "extends": "./configs/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,

    // Nothing here is compiled — bin/devkit.mjs installs a loader that
    // transforms .ts at run time (see bin/loader.mjs). So the specifier is the
    // real filename: './router.ts', not './router.js'.
    "allowImportingTsExtensions": true,

    // devkit's own bin/ only; the shared base deliberately declares no module
    // system, so consumers pick their own.
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // The dashboard page (bin/dashboard/web) is React, built by Vite.
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    // The shadcn CLI writes the page's components with `@/` imports.
    "paths": { "@/*": ["./bin/dashboard/web/*"] }
  },
  "include": ["bin/**/*.ts", "bin/**/*.tsx", "bin/**/*.d.mts", "test/**/*.ts"],
  // The page has its own config (bin/dashboard/web/tsconfig.json).
  "exclude": ["bin/dashboard/web"]
}
