{
  "name": "@gingur-root/devkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "devkit": "./bin/devkit.mjs"
  },
  "scripts": {
    "hooks:install": "node bin/devkit.mjs hooks install",
    "lint": "node bin/devkit.mjs lint",
    "lint:fix": "node bin/devkit.mjs lint --fix",
    "fmt": "node bin/devkit.mjs fmt",
    "fmt:check": "node bin/devkit.mjs fmt --check",
    "staged": "node bin/devkit.mjs staged",
    "agent": "node bin/devkit.mjs agent",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "exports": {
    "./tsconfig": "./configs/tsconfig.base.json",
    "./oxlint": "./configs/oxlintrc.base.json",
    "./oxfmt": "./configs/oxfmt.config.mjs",
    "./lint-staged": "./configs/lint-staged.config.js"
  },
  "files": [
    "bin",
    "configs",
    "actions",
    "agents",
    "skills",
    ".github"
  ],
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@openai/codex-sdk": "0.162.1",
    "typescript": "^6 || ^7"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "lint-staged": "^16",
    "oxc-transform": "0.150.0",
    "oxfmt": "0.58.0",
    "oxlint": "^1.73",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@openai/codex-sdk": "0.162.1",
    "@types/node": "^24.19.2",
    "typescript": "^7",
    "vite-plus": "1.1.0",
    "yaml": "^2"
  }
}
